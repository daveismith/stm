{
  "name": "shoot-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@babylonjs/core": "^9.21.2",
    "@babylonjs/gui": "^9.21.2",
    "@babylonjs/loaders": "^9.21.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.0.1",
    "@mui/styled-engine-sc": "^9.3.0",
    "@mui/system": "^9.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "google-protobuf": "^4.0.0",
    "grpc-web": "^2.0.2",
    "immer": "^11.1.18",
    "proto": "file:src/proto",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "styled-components": "^6.5.3",
    "tss-react": "^4.9.21",
    "web-vitals": "^6.1.1"
  },
  "scripts": {
    "start": "node ngrok.js && VITE_CJS_TRACE=true vite --port=8001",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "grpc": "protoc -I ../../backend/ShootTheMoon/ShootTheMoon/schema shoot.proto --js_out=import_style=commonjs,binary:src/proto --grpc-web_out=import_style=typescript,mode=grpcwebtext:src/proto"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/events": "^3.0.3",
    "@types/jest": "^30.0.0",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "overrides": {
    "vite-tsconfig-paths": {
      "typescript": "$typescript"
    }
  }
}
