{
  "name": "shoot-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@babylonjs/core": "^9.15.0",
    "@babylonjs/gui": "^9.15.0",
    "@babylonjs/loaders": "^9.15.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/styled-engine-sc": "^9.0.1",
    "@mui/system": "^9.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "google-protobuf": "^4.0.0",
    "grpc-web": "^2.0.2",
    "immer": "^11.1.3",
    "proto": "file:src/proto",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "styled-components": "^6.4.2",
    "tss-react": "^4.9.21",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "start": "node ngrok.js && VITE_CJS_TRACE=true vite --port=8001",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "grpc": "protoc -I ../../backend/ShootTheMoon/ShootTheMoon/schema shoot.proto --js_out=import_style=commonjs,binary:src/proto --grpc-web_out=import_style=typescript,mode=grpcwebtext:src/proto"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/events": "^3.0.3",
    "@types/jest": "^30.0.0",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
