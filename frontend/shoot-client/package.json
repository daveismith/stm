{
  "name": "shoot-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@babylonjs/core": "^8.30.5",
    "@babylonjs/gui": "^8.30.5",
    "@babylonjs/loaders": "^8.30.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.1.0",
    "@mui/styled-engine-sc": "^7.3.3",
    "@mui/system": "^7.1.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "google-protobuf": "^4.0.0",
    "grpc-web": "^2.0.2",
    "immer": "^10.1.3",
    "proto": "file:src/proto",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "^7.9.4",
    "styled-components": "^6.1.19",
    "tss-react": "^4.9.19",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "start": "node ngrok.js && VITE_CJS_TRACE=true vite --port=8001",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "grpc": "protoc -I ../../backend/ShootTheMoon/ShootTheMoon/schema shoot.proto --js_out=import_style=commonjs,binary:src/proto --grpc-web_out=import_style=typescript,mode=grpcwebtext:src/proto"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
